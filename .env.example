# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Адрес и имя модели сверьте с документацией провайдера (docs/nastroyka-ii.md, раздел 4).

# Адрес API в формате OpenAI Chat Completions, например:
#   https://api.openai.com/v1
#   https://api.deepseek.com
#   http://localhost:11434/v1   (Ollama, ключ не нужен)
AI_BASE_URL=

# Ключ API; для локальной модели оставьте пустым
AI_API_KEY=

# Имя модели у провайдера
AI_MODEL=

# Схема авторизации, если провайдер требует не Bearer
AI_AUTH_SCHEME=Bearer
